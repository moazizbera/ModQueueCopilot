{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "modqueue-copilot",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Analyze with ModQueue Copilot",
        "description": "Directly analyze this post with a linked moderation console",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/analyze-current-post"
      },
      {
        "label": "Auto-set post status",
        "description": "Apply the recommended moderation status to this post",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/auto-moderate-current-post"
      },
      {
        "label": "Approve post",
        "description": "Approve this post from the Reddit menu",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/approve-current-post"
      },
      {
        "label": "Mark post for review",
        "description": "Flag this post for moderator review from the menu",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/review-current-post"
      },
      {
        "label": "Remove post",
        "description": "Remove this post from the Reddit menu",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/remove-current-post"
      },
      {
        "label": "Analyze Reddit post by URL or ID",
        "description": "Paste a post URL or ID when you want to analyze a post directly",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/analyze-post-form"
      },
      {
        "label": "Create spam demo post",
        "description": "Seed a high-confidence spam scenario",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create-spam"
      },
      {
        "label": "Create promotion demo post",
        "description": "Seed a promotional edge case",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create-promotion"
      },
      {
        "label": "Create question demo post",
        "description": "Seed a good-faith rules question",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create-question"
      },
      {
        "label": "Create discussion demo post",
        "description": "Seed a healthy community discussion",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create-discussion"
      }
    ]
  },
  "forms": {
    "analyzePostForm": "/internal/form/analyze-post-submit",
    "spamDemoPostForm": "/internal/form/create-spam-demo-post-submit",
    "promotionDemoPostForm": "/internal/form/create-promotion-demo-post-submit",
    "questionDemoPostForm": "/internal/form/create-question-demo-post-submit",
    "discussionDemoPostForm": "/internal/form/create-discussion-demo-post-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build"
  },
  "dev": {
    "subreddit": "modqueue_copilot_dev"
  }
}